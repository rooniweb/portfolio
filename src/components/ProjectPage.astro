---
import Layout from './Layout.astro';
import { person, ui, projects } from '../data/content';
import { details } from '../data/details';
import { t, href } from '../lib/i18n';
import Replay from './Replay.astro';
const demoKey: Record<string, 'migroo' | 'privasearch' | 'agent'> = { migroo: 'migroo', privasearch: 'privasearch', 'orange-money-agent': 'agent' };

interface Props { lang: 'en' | 'fr'; slug: string }
const { lang, slug } = Astro.props;
const d = details.find((x) => x.slug === slug)!;
const p = projects.find((x) => x.id === d.projectId)!;
const next = details[(details.indexOf(d) + 1) % details.length];
const nextP = projects.find((x) => x.id === next.projectId)!;
const title = `${p.title.en} · ${person.name}`;
---
<Layout lang={lang} title={title} description={d.lead[lang]}>
  <main id="top" class="wrap detail">
    <a class="back" href={href(lang, '/#projects')} data-path="/#projects" set:html={t(ui.backHome)} />

    <header class="d-head">
      <h1 set:html={t(p.title)} />
      <p class="d-sum" set:html={t(p.summary!)} />
      <p class="chips">
        {p.status && <span class={`status ${p.status}`} set:html={t(ui.status[p.status])} />}
        {(p.tags ?? []).map((tg) => <span class="tag">{tg}</span>)}
      </p>
      <p class="d-lead" set:html={t(d.lead)} />
      {p.links && (
        <p class="plinks">
          {p.links.map((l) => <a href={l.url} target={l.url.startsWith('http') ? '_blank' : undefined} rel="noopener" set:html={t(l.label)} />)}
        </p>
      )}
    </header>

    <figure class="d-figure">
      <figcaption set:html={t(d.diagramTitle)} />
      <div class="dg-scroll" tabindex="0" set:html={d.svg} />
      <p class="dg-hint" set:html={t(ui.diagramNote)} />
    </figure>

    {d.chart && (
      <figure class="d-figure d-chart">
        <figcaption set:html={t(d.chart.title)} />
        <div class="dg-scroll" tabindex="0" set:html={d.chart.svg} />
        <p class="dg-note" set:html={t(d.chart.note)} />
      </figure>
    )}

    {d.poc && (
      <section class="d-demo">
        <h2 set:html={t(ui.pocTitle)} />
        <p set:html={t(d.poc.lead)} />
        <p class="plinks"><a href={d.poc.url} target="_blank" rel="noopener" set:html={t(ui.pocOpen)} /></p>
        <div class="poc-frame">
          <iframe src={d.poc.url} title={`${p.title.en} demo`} loading="lazy" style={d.poc.height ? `height:${d.poc.height}px` : undefined}></iframe>
        </div>
      </section>
    )}

    {(d.results || d.table) && (
      <section class="d-results">
        <h2 set:html={t(ui.resultsTitle)} />
        {d.table && (
          <div class="r-table">
            <table>
              <thead><tr>{d.table.head.map((h) => <th set:html={t(h)} />)}</tr></thead>
              <tbody>
                {d.table.rows.map((row, i) => (
                  <tr class={i === d.table!.highlight ? 'hi' : i === d.table!.muted ? 'mu' : ''}>
                    {row.map((c) => <td set:html={t(c as any)} />)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <ul class="paras">{(d.results ?? []).map((r) => <li><span set:html={t(r)} /></li>)}</ul>
      </section>
    )}

    {demoKey[slug] && (
      <section class="d-demo">
        <h2 set:html={t(ui.demoSectionTitle)} />
        <p set:html={t(ui.demoSectionLead)} />
        <Replay demo={demoKey[slug]} />
      </section>
    )}

    <section class="d-grid">
      <div>
        <h2 set:html={t(ui.stepsTitle)} />
        <ol class="steps">
          {d.steps.map((s) => (
            <li>
              <h3 set:html={t(s.title)} />
              <p set:html={t(s.text)} />
            </li>
          ))}
        </ol>
      </div>
      <aside>
        <h2 set:html={t(ui.choicesTitle)} />
        <ul class="paras">
          {p.bullets.map((b) => <li><span set:html={t(b.text)} /></li>)}
          {(d.notes ?? []).map((n) => <li><span set:html={t(n)} /></li>)}
        </ul>
        {d.example && (
          <figure class="code">
            <figcaption set:html={t(d.example.caption)} />
            <pre><code>{d.example.code}</code></pre>
          </figure>
        )}
      </aside>
    </section>

    <nav class="d-next" aria-label={ui.nextProject[lang]}>
      <span set:html={t(ui.nextProject)} />
      <a href={href(lang, `/projects/${next.slug}/`)} data-path={`/projects/${next.slug}/`} set:html={t(nextP.title)} />
    </nav>
  </main>
</Layout>
