---
import { person, ui } from '../data/content';
import { t, href } from '../lib/i18n';
import replayCode from '../scripts/replay.js?raw';
import '../styles/global.css';

interface Props {
  lang: 'en' | 'fr';
  title: string;
  description: string;
  home?: boolean;
}
const { lang, title, description, home = false } = Astro.props;
// On the home page, nav links are in-page anchors; elsewhere they point back home.
const nav = (id: string) => (home ? `#${id}` : href(lang, `/#${id}`));
const sections = [
  ['offer', ui.nav.offer],
  ['ask', ui.nav.demo],
  ['cases', ui.nav.cases],
  ['path', ui.nav.path],
  ['stack', ui.nav.stack],
] as const;

// Same page in the other language, for the switch and for search engines.
const base = Astro.url.pathname.replace(/^\/fr(?=\/|$)/, '') || '/';
const other = lang === 'en' ? 'fr' : 'en';
const otherPath = other === 'fr' ? '/fr' + base : base;
const abs = (p: string) => new URL(p, Astro.site).href;
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%230e0f11'/%3E%3Crect x='1.5' y='1.5' width='29' height='29' rx='3' fill='none' stroke='%23f0b13c' stroke-width='1.5'/%3E%3Ctext x='16' y='21' font-family='ui-monospace,Menlo,monospace' font-weight='700' font-size='13' fill='%23f0b13c' text-anchor='middle'%3EAD%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang={lang} data-lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0e0f11" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={abs('/img/arona.webp')} />
  <link rel="canonical" href={abs(Astro.url.pathname)} />
  <link rel="alternate" hreflang="en" href={abs(base)} />
  <link rel="alternate" hreflang="fr" href={abs('/fr' + base)} />
  <link rel="alternate" hreflang="x-default" href={abs(base)} />
  <link rel="icon" href={favicon} />
  <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/geist-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline set:html={`(function(){var r=document.documentElement,l='${lang}';r.classList.add('js');
    if(l==='en'){try{if(localStorage.getItem('lang')==='fr'){location.replace('/fr'+location.pathname+location.hash);return;}}catch(e){}}
    try{if(localStorage.getItem('theme')==='light')r.setAttribute('data-theme','light');}catch(e){}})();`}></script>
</head>
<body>
  <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
  <a class="skip" href={home ? '#ask' : '#main'} set:html={t(home ? ui.skip : ui.skipMain)} />

  <header class="top">
    <div class="wrap top-in">
      <a class="brand" href={home ? '#top' : href(lang, '/')}><span class="glyph" aria-hidden="true">AD</span><span>{person.shortName}</span></a>
      <button class="menu-btn" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" set:html={t(ui.menu)} />
      <nav id="site-nav" aria-label="Sections">
        {sections.map(([id, label]) => <a href={nav(id)} set:html={t(label)} />)}
        <a href={href(lang, '/articles/')} set:html={t(ui.nav.articles)} />
        <a href={nav('contact')} set:html={t(ui.nav.contact)} />
      </nav>
      <button class="theme" id="theme-toggle" type="button" aria-label={ui.themeToggle[lang]} title={ui.themeToggle[lang]}>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g></svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor"/></svg>
      </button>
      <a class="lang" id="lang-toggle" href={otherPath} hreflang={other} lang={other} aria-label={ui.langSwitchLabel[lang]}>{other.toUpperCase()}</a>
    </div>
  </header>

  <slot />

  <footer class="foot">
    <div class="wrap frame foot-in">
      <p set:html={t(ui.footer)} />
      <p class="foot-links">
        <a href={href(lang, '/articles/')} set:html={t(ui.nav.articles)} />
        <a href={person.github} rel="noopener">GitHub</a>
        <a href={person.linkedin} rel="noopener">LinkedIn</a>
        <a href={`mailto:${person.email}`} set:html={t(ui.cta)} />
      </p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      // The language link is a real link; clicking it also remembers the choice and keeps the anchor.
      var langLink = document.getElementById('lang-toggle');
      langLink.addEventListener('click', function (e) {
        try { localStorage.setItem('lang', langLink.getAttribute('hreflang')); } catch (err) {}
        if (location.hash) { e.preventDefault(); location.href = langLink.getAttribute('href') + location.hash; }
      });
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        if (next === 'light') root.setAttribute('data-theme', 'light'); else root.removeAttribute('data-theme');
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      // Small-screen menu.
      var menu = document.getElementById('menu-toggle'), navEl = document.getElementById('site-nav');
      function setMenu(open) { menu.setAttribute('aria-expanded', open ? 'true' : 'false'); navEl.classList.toggle('open', open); }
      menu.addEventListener('click', function () { setMenu(menu.getAttribute('aria-expanded') !== 'true'); });
      navEl.addEventListener('click', function (e) { if (e.target.closest('a')) setMenu(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setMenu(false); });
      // Reading progress bar under the header.
      var bar = document.getElementById('progress-bar'), ticking = false;
      function update() {
        var h = document.documentElement.scrollHeight - innerHeight;
        bar.style.transform = 'scaleX(' + (h > 0 ? Math.min(1, scrollY / h) : 0) + ')';
        ticking = false;
      }
      addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      addEventListener('resize', update);
      update();
      // Sections fade in once as they enter the viewport. Skipped with reduced motion.
      var els = document.querySelectorAll('[data-reveal]');
      if (els.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        root.classList.add('reveal');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      }
    })();
  </script>
  <script is:inline set:html={replayCode}></script>
  <slot name="scripts" />
</body>
</html>
