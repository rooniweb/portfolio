---
import Layout from './Layout.astro';
import { person, ui, path, services, dataFacets, experience, projects, stack, education, buildCorpus } from '../data/content';
import Replay from './Replay.astro';
import { t, href } from '../lib/i18n';
import retrieverCode from '../scripts/retriever.js?raw';

interface Props { lang: 'en' | 'fr' }
const { lang } = Astro.props;

const api = import.meta.env.PUBLIC_RAG_API ?? '';
const data = JSON.stringify({ corpus: buildCorpus(), ui, api }).replace(/</g, '\\u003c');

const title = `${person.name} · ${person.role[lang]}`;
const description = ui.heroLead[lang];
const suggestions = ui.demoSuggestions.en.map((en, i) => ({ en, fr: ui.demoSuggestions.fr[i] }));
const migrooChain = ['Sources', 'Parsing', 'Chunking', 'Metadata', 'Embeddings', 'Qdrant', 'Retrieval', 'LLM context'];
---
<Layout lang={lang} title={title} description={description} home>
  <main id="top">
    <section class="hero wrap">
      <div class="hero-text">
      <p class="who"><span set:html={t(person.role)} /><span class="sep" aria-hidden="true">/</span><span set:html={t(ui.trainedAs)} /><span class="sep" aria-hidden="true">/</span><span set:html={t(person.location)} /></p>
      <h1 set:html={t(ui.heroTitle)} />
      <p class="lead" set:html={t(ui.heroLead)} />
      <p class="ctas">
        <a class="btn primary" href={`mailto:${person.email}`} set:html={t(ui.ctaContact)} />
        <a class="btn" href="#projects" set:html={t(ui.ctaProjects)} />
        <a class="plain" href={person.github} rel="noopener">GitHub</a>
        <a class="plain" href={person.linkedin} rel="noopener">LinkedIn</a>
      </p>
      </div>
      <figure class="portrait">
        <img src="/img/arona.webp" width="640" height="640" alt={ui.photoAlt[lang]} />
      </figure>
    </section>

    <section id="ask" class="ask" aria-labelledby="ask-title">
      <div class="wrap">
        <div class="ask-head">
          <h2 id="ask-title" set:html={t(ui.demoTitle)} />
          <p set:html={t(ui.demoLead)} />
        </div>
        <div class="console">
          <form id="rag-form" role="search">
            <label for="rag-q" class="sr" set:html={t(ui.demoTitle)} />
            <input id="rag-q" name="q" type="search" autocomplete="off" />
            <button type="submit" set:html={t(ui.demoButton)} />
          </form>
          <div class="suggest">
            <span class="try" set:html={t(ui.demoTry)} />
            {suggestions.map((s) => <button type="button" data-suggest set:html={t(s)} />)}
          </div>
          <ol class="pipe" aria-hidden="true">
            {ui.demoPipeline.map((p) => <li>{p}</li>)}
          </ol>
          <p id="rag-stats" class="stats" aria-live="polite"></p>
          <div id="rag-results" aria-live="polite"></div>
          <p class="note" set:html={t(ui.demoNote)} />
        </div>
      </div>
    </section>

    <section id="services" class="wrap block" aria-labelledby="services-title">
      <div class="sec-head">
        <h2 id="services-title" set:html={t(ui.servicesTitle)} />
        <p set:html={t(ui.servicesLead)} />
      </div>
      <ol class="services-grid">
        {services.map((s) => (
          <li>
            <h3 set:html={t(s.title)} />
            <p set:html={t(s.text)} />
            <p class="proof" set:html={t(s.proof)} />
          </li>
        ))}
      </ol>
      <article class="km-card">
        <div>
          <p class="a-meta"><span set:html={t(ui.articleLabel)} /></p>
          <h3 set:html={t(ui.kmTitle)} />
          <p set:html={t(ui.kmText)} />
          <p class="plinks">
            <a href={href(lang, '/articles/knowledge-management-ai/')} data-path="/articles/knowledge-management-ai/" set:html={t(ui.readArticle)} />
            <a href={href(lang, '/projects/migroo/')} data-path="/projects/migroo/">Migroo</a>
            <a href={href(lang, '/projects/privasearch/')} data-path="/projects/privasearch/">PrivaSearch</a>
          </p>
        </div>
        <ol class="km-flow" aria-hidden="true">
          <li><span set:html={t({ en: 'Scattered documents', fr: 'Documents dispersés' })} /></li>
          <li class="p"><strong>Migroo</strong><span set:html={t({ en: 'ingest · chunk · index', fr: 'ingérer · découper · indexer' })} /></li>
          <li class="p"><strong>PrivaSearch</strong><span set:html={t({ en: 'search · on premise', fr: 'rechercher · on-premise' })} /></li>
          <li class="end"><span set:html={t({ en: 'Sourced answers', fr: 'Réponses sourcées' })} /></li>
        </ol>
      </article>

      <div class="services-demo">
        <h3 set:html={t({ en: 'Email triage: n8n, a decision layer (TypeSafe Jev) and an LLM', fr: 'Tri d’e-mails : n8n, une couche de décision (TypeSafe Jev) et un LLM' })} />
        <Replay demo="email" />
      </div>
    </section>

    <section id="data" class="wrap block" aria-labelledby="data-title">
      <div class="sec-head">
        <h2 id="data-title" set:html={t(ui.dataTitle)} />
        <p set:html={t(ui.dataLead)} />
      </div>
      <div class="data-grid">
        <ul class="facets">
          {dataFacets.map((f) => (
            <li>
              <h3 set:html={t(f.title)} />
              <p set:html={t(f.text)} />
              <p class="chips">{f.tags.map((tg) => <span class="tag">{tg}</span>)}</p>
            </li>
          ))}
        </ul>
        <figure class="dash" aria-labelledby="dash-title">
          <div class="dash-head">
            <span id="dash-title" class="dash-title" set:html={t(ui.dashTitle)} />
            <span class="rp-badge" set:html={t(ui.demoBadge)} />
          </div>
          <div class="kpis">
            <div><span class="k-val" set:html={t({ en: '48,210', fr: '48 210' })} /><span class="k-lab" set:html={t({ en: 'invoices sent', fr: 'factures envoyées' })} /></div>
            <div><span class="k-val" set:html={t({ en: '95.8%', fr: '95,8 %' })} /><span class="k-lab" set:html={t({ en: 'delivered', fr: 'remises' })} /></div>
            <div><span class="k-val warn" set:html={t({ en: '2,034', fr: '2 034' })} /><span class="k-lab" set:html={t({ en: 'failed sends', fr: 'échecs d’envoi' })} /></div>
          </div>
          <p class="dash-sub" set:html={t({ en: 'Failure causes', fr: 'Causes des échecs' })} />
          <ul class="causes">
            {[
              [{ en: 'Invalid address', fr: 'Adresse invalide' }, 812],
              [{ en: 'Mailbox full', fr: 'Boîte pleine' }, 534],
              [{ en: 'Rejected by recipient server', fr: 'Rejet du serveur destinataire' }, 401],
              [{ en: 'Send server timeout', fr: 'Délai du serveur d’envoi' }, 287],
            ].map(([lab, n]) => (
              <li>
                <span class="c-lab" set:html={t(lab as any)} />
                <span class="c-bar"><span style={`width:${(100 * (n as number)) / 812}%`}></span></span>
                <span class="c-val">{n}</span>
              </li>
            ))}
          </ul>
          <figcaption set:html={t(ui.dashNote)} />
        </figure>
      </div>
    </section>

    <section id="path" class="wrap block" aria-labelledby="path-title">
      <div class="sec-head">
        <h2 id="path-title" set:html={t(ui.pathTitle)} />
        <p set:html={t(ui.pathLead)} />
      </div>
      <ol class="path">
        {path.map((p) => (
          <li>
            <span class="when" set:html={t(p.when as any)} />
            <h3 set:html={t(p.title)} />
            <p set:html={t(p.text)} />
          </li>
        ))}
      </ol>
    </section>

    <section id="work" class="wrap block" aria-labelledby="work-title">
      <div class="sec-head"><h2 id="work-title" set:html={t(ui.workTitle)} /></div>
      {experience.map((it) => (
        <article class="role">
          <div class="role-meta">
            <h3 set:html={t(it.title)} />
            <p class="org" set:html={t(it.org!)} />
            <p class="when">{it.when}</p>
          </div>
          <ol class="paras">
            {it.bullets.map((b, i) => (
              <li data-chunk={`${it.id}#${i + 1}`}><span set:html={t(b.text)} /></li>
            ))}
          </ol>
        </article>
      ))}
    </section>

    <section id="projects" class="wrap block" aria-labelledby="projects-title">
      <div class="sec-head">
        <h2 id="projects-title" set:html={t(ui.projectsTitle)} />
        <p set:html={t(ui.projectsLead)} />
      </div>
      {projects.map((it, idx) => (
        <article class={idx === 0 ? 'proj feature' : 'proj'}>
          <div class="proj-meta">
            <h3>{it.title.en}</h3>
            <p class="sum" set:html={t(it.summary!)} />
            <p class="chips">
              {it.status && <span class={`status ${it.status}`} set:html={t(ui.status[it.status])} />}
              {(it.tags ?? []).map((tg) => <span class="tag">{tg}</span>)}
            </p>
            {(it.page || it.links) && (
              <p class="plinks">
                {it.page && <a href={href(lang, `/projects/${it.page}/`)} data-path={`/projects/${it.page}/`} set:html={t(ui.howItWorks)} />}
                {(it.links ?? []).map((l) => <a href={l.url} target="_blank" rel="noopener" set:html={t(l.label)} />)}
              </p>
            )}
          </div>
          <div class="proj-body">
            {idx === 0 && (
              <ol class="chain" aria-label="Migroo pipeline">
                {migrooChain.map((s) => <li>{s}</li>)}
              </ol>
            )}
            <ol class="paras">
              {it.bullets.map((b, i) => (
                <li data-chunk={`${it.id}#${i + 1}`}><span set:html={t(b.text)} /></li>
              ))}
            </ol>
          </div>
        </article>
      ))}
    </section>

    <section id="stack" class="wrap block two" aria-labelledby="stack-title">
      <div>
        <div class="sec-head"><h2 id="stack-title" set:html={t(ui.stackTitle)} /></div>
        <dl class="stack">
          {stack.map((s, i) => (
            <div data-chunk={`stack#${i + 1}`}>
              <dt set:html={t(s.group)} />
              <dd>
                {s.items.join(' · ')}
                {s.note && <small set:html={t(s.note)} />}
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <div class="sec-head"><h2 set:html={t(ui.eduTitle)} /></div>
        <ul class="edu">
          {education.map((e, i) => (
            <li data-chunk={`edu#${i + 1}`}>
              <strong set:html={t(e.title)} />
              <span set:html={t(e.org)} />
              {(e as any).note && <small set:html={t((e as any).note)} />}
              {e.link && <a href={e.link} rel="noopener" set:html={t(ui.verify)} />}
            </li>
          ))}
          <li data-chunk="profile#1"><strong set:html={t({ en: 'Languages', fr: 'Langues' })} /><span set:html={t(ui.languages)} /></li>
        </ul>
      </div>
    </section>

    <section id="passion" class="wrap block passion" aria-labelledby="passion-title">
      <div class="passion-text">
        <div class="sec-head"><h2 id="passion-title" set:html={t(ui.passionTitle)} /></div>
        <p set:html={t(ui.passionText)} />
        <a href={person.linkedin} rel="noopener" set:html={t(ui.passionLink)} />
      </div>
      <figure class="legends">
        <img src="/img/legends.webp" width="768" height="512" loading="lazy" alt={ui.passionAlt[lang]} />
        <figcaption set:html={t(ui.passionCaption)} />
      </figure>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 id="contact-title" set:html={t(ui.contactTitle)} />
        <p set:html={t(ui.contactLead)} />
        <a class="mail" href={`mailto:${person.email}`}>{person.email}</a>
        <p class="links">
          <a href={person.linkedin} rel="noopener">LinkedIn</a>
          <a href={person.github} rel="noopener">GitHub</a>
          <span set:html={t(person.location)} />
        </p>
      </div>
    </section>
  </main>
  <Fragment slot="scripts">
    <script type="application/json" id="rag-data" set:html={data}></script>
    <script is:inline set:html={retrieverCode}></script>
  </Fragment>
</Layout>
